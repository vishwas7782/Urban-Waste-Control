# Server
PORT=3000
SERVER_URL=http://localhost:3000

# Client (frontend) base URL used in verification emails
CLIENT_URL=http://localhost:5173

# Database. Local Mongo, or an Atlas SRV string.
# NOTE: always end the URI with an explicit database name (e.g. /UrbanWaste-db),
# otherwise the driver falls back to the "test" database.
MONGO_URI=mongodb://localhost:27017/UrbanWaste-db
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/UrbanWaste-db?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_me

# Email (Gmail service). Use an app password if 2FA is enabled.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
